# Chave PÚBLICA do Mercado Pago (pode ir para o frontend). NUNCA use o Access Token/Secret aqui.
VITE_MERCADO_PAGO_PUBLIC_KEY=sua_public_key_do_mercado_pago

# URL base da API do backend, sem barra no final.
# Em produção precisa ser definida nas Environment Variables do projeto na Vercel —
# o build embute o valor, então mudá-la exige um novo deploy.
# Ex: VITE_API_URL=https://api.lckp.com.br
VITE_API_URL=http://localhost:3000
