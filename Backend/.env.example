# ---- Servidor ----
PORT=3000

# Origens liberadas no CORS (separadas por vírgula, sem barra no final).
# Em produção inclua o domínio do site, mantenha o localhost só se for usar dev
# contra esta mesma API.
# Ex: CORS_ORIGINS=https://lckp.com.br,https://www.lckp.com.br,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- Supabase ----
SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Chave SECRETA (service_role). Só no backend, NUNCA no frontend nem no Git.
SUPABASE_SERVICE_ROLE_KEY=coloque_a_service_role_key_aqui

# ---- Autenticação ----
# Gere um valor longo e aleatório. Ex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio

# ---- Mercado Pago ----
MP_ACCESS_TOKEN=seu_access_token_do_mercado_pago
# Segredo da assinatura do Webhook (painel MP > Webhooks > "Assinatura secreta")
MP_WEBHOOK_SECRET=seu_webhook_secret_do_mercado_pago
# URL pública que o Mercado Pago consegue alcançar (ngrok em dev, domínio real em prod)
BACKEND_PUBLIC_URL=https://sua-url-publica.exemplo.dev

# ---- E-mail transacional (Resend) ----
# Sem a chave o envio e DESLIGADO e registrado em log: um pagamento aprovado
# nao pode falhar porque o e-mail nao saiu.
RESEND_API_KEY=
# Precisa ser de dominio VERIFICADO no Resend. lckp.com.br ja esta verificado.
EMAIL_REMETENTE=LockUp <nao-responda@lckp.com.br>

# ---------------------------------------------------------------------
# Credenciais de gateway por escola
# ---------------------------------------------------------------------
# Chave que cifra as credenciais guardadas no banco (AES-256-GCM).
# 32 bytes em hexadecimal (64 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# PRECISA ser o MESMO valor em todos os ambientes que falam com o mesmo
# Supabase. A credencial cifrada com uma chave nao decifra com outra: trocar
# este valor invalida TODAS as credenciais ja cadastradas.
CREDENCIAIS_SECRET=

# ---------------------------------------------------------------------
# Banco do Brasil (opcional)
# ---------------------------------------------------------------------
# Os enderecos do BB tem padrao no codigo (producao e sandbox). Estas duas
# variaveis existem so para o caso de o banco entregar um endereco diferente
# do documentado — assim a correcao e configuracao no Render, nao deploy.
# Deixe VAZIAS a menos que o banco informe outra coisa.
BB_OAUTH_URL=
BB_API_URL=
