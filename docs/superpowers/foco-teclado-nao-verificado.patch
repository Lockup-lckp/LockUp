+// Acha em qual parada está um armário, pelo bloco que o contém: o centro do
+// bloco é o mesmo valor usado para montar lay.paradas.
+function paradaDoArmario(lay, armarioId) {
+  for (const item of lay.itens) {
+    if (item.tipo !== 'bloco') continue;
+    const estaNesteBloco = item.colunas.some((coluna) => coluna.some((a) => a?.id === armarioId));
+    if (!estaNesteBloco) continue;
+    const centro = item.x + item.largura / 2;
+    return lay.paradas.findIndex((p) => p.centro === centro);
+  }
+  return -1;
+}
